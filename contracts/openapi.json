{
  "openapi": "3.0.3",
  "info": {
    "title": "Smart Door API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/devices/door-01/state": {
      "get": {
        "operationId": "getDoorState",
        "responses": {
          "200": {
            "description": "Latest readings and device connectivity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DoorState"
                }
              }
            }
          }
        }
      }
    },
    "/devices/door-01/readings": {
      "get": {
        "operationId": "getDoorReadings",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "source",
            "in": "query",
            "description": "Filter to combined snapshot rows. Omit to include legacy per-message rows.",
            "schema": {
              "type": "string",
              "enum": ["combined"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sensor history",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Reading"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid source filter"
          }
        }
      }
    },
    "/devices/door-01/commands": {
      "post": {
        "operationId": "createDoorCommand",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommandRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Command sent to the MQTT broker",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandSent"
                }
              }
            }
          },
          "400": {
            "description": "Invalid command"
          },
          "503": {
            "description": "MQTT broker is unavailable or publish failed"
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "responses": {
          "200": {
            "description": "Process is running"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "responses": {
          "200": {
            "description": "Dependencies ready"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/devices/door-01/events": {
      "get": {
        "operationId": "getDoorEvents",
        "responses": {
          "200": {
            "description": "Recent access and alert events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DoorEvent"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/faces/sync": {
      "get": {
        "operationId": "getFaceSync",
        "responses": {
          "200": {
            "description": "Current face-cache version and Pi acknowledgment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FaceSyncState"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "publishFaceSync",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FaceSyncRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Complete snapshot stored for retained MQTT publish",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FaceSyncState"
                }
              }
            }
          },
          "400": {
            "description": "Invalid snapshot"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Reading": {
        "type": "object",
        "required": [
          "id",
          "source",
          "recorded_at",
          "received_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "type": "string",
            "enum": [
              "node",
              "gateway",
              "combined"
            ]
          },
          "sensor": {
            "type": "string",
            "enum": ["motion", "door", "distance", "light", "vibration"],
            "description": "Absent on readings stored before sensor topics were adopted."
          },
          "device_id": { "type": "string" },
          "boot_id": { "type": "string" },
          "seq": { "type": "integer", "format": "int64" },
          "uptime_ms": { "type": "integer", "format": "int64" },
          "simulated": { "type": "boolean" },
          "valid": { "type": "boolean" },
          "error": { "type": "string" },
          "payload": {
            "type": "object",
            "additionalProperties": true,
            "description": "Original MQTT JSON payload on legacy per-message rows."
          },
          "samples": {
            "type": "object",
            "description": "Per-sensor provenance for combined five-second snapshots. Values are in the top-level sensor fields; absent or stale sensors have no entry.",
            "additionalProperties": {
              "$ref": "#/components/schemas/SnapshotSample"
            }
          },
          "door_open": {
            "type": "boolean",
            "nullable": true
          },
          "lock_state": {
            "type": "string",
            "nullable": true
          },
          "presence": {
            "type": "boolean",
            "nullable": true
          },
          "motion": {
            "type": "boolean",
            "nullable": true
          },
          "vibration": {
            "type": "boolean",
            "nullable": true
          },
          "temperature_c": {
            "type": "number",
            "nullable": true
          },
          "distance_mm": {
            "type": "number",
            "nullable": true
          },
          "light_lux": {
            "type": "number",
            "nullable": true
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SnapshotSample": {
        "type": "object",
        "required": ["id", "device_id", "boot_id", "seq", "simulated", "valid", "recorded_at", "received_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "device_id": { "type": "string" },
          "boot_id": { "type": "string" },
          "seq": { "type": "integer", "format": "int64" },
          "uptime_ms": { "type": "integer", "format": "int64" },
          "simulated": { "type": "boolean" },
          "valid": { "type": "boolean" },
          "error": { "type": "string" },
          "recorded_at": { "type": "string", "format": "date-time" },
          "received_at": { "type": "string", "format": "date-time" }
        }
      },
      "DoorState": {
        "type": "object",
        "required": [
          "door_id",
          "online",
          "readings",
          "mqtt_connected"
        ],
        "properties": {
          "door_id": {
            "type": "string",
            "const": "door-01"
          },
          "online": {
            "type": "boolean"
          },
          "readings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Reading"
            }
          },
          "mqtt_connected": {
            "type": "boolean",
            "description": "Whether the API is connected to the MQTT broker."
          }
        }
      },
      "CommandRequest": {
        "type": "object",
        "required": [
          "action"
        ],
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "lock",
              "unlock"
            ]
          }
        }
      },
      "CommandSent": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "DoorEvent": {
        "type": "object",
        "required": [
          "id",
          "source",
          "kind",
          "payload",
          "recorded_at",
          "received_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FacePerson": {
        "type": "object",
        "required": [
          "id",
          "name",
          "embeddings"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "embeddings": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "array",
              "minItems": 128,
              "maxItems": 128,
              "items": {
                "type": "number"
              }
            }
          }
        }
      },
      "FaceSyncRequest": {
        "type": "object",
        "required": [
          "model_version",
          "people"
        ],
        "properties": {
          "model_version": {
            "type": "string"
          },
          "people": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FacePerson"
            }
          }
        }
      },
      "FaceSyncState": {
        "type": "object",
        "required": [
          "version",
          "people"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "applied_version": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "model_version": {
            "type": "string"
          },
          "people": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FacePerson"
            }
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
